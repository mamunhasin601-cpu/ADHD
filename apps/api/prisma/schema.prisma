// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Subscription Plan
// ──────────────────────────────────────────────

enum Plan {
  FREE
  PRO
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────

model User {
  id                      String   @id @default(uuid())
  email                   String?  @unique
  phone                   String?  @unique
  passwordHash            String
  timezone                String   @default("Europe/Moscow")
  hasCompletedOnboarding  Boolean  @default(false)
  plan   Plan     @default(FREE)
  proExpiresAt            DateTime? // null = навсегда (если Pro) или не Pro
  expoPushToken           String?  // Deprecated: use DeviceToken table. Kept for backward compat during migration.
  
  // OAuth provider IDs
  yandexId                String?  @unique
  vkId                    String?  @unique
  mailruId                String?  @unique
  
  createdAt               DateTime @default(now())

  tasks                 Task[]
  routines              Routine[]
  hostedSessions        FocusSession[]            @relation("HostedSessions")
  sessionParticipations FocusSessionParticipant[]
  notificationLogs      NotificationLog[]
  deviceTokens          DeviceToken[]

  @@map("users")
}

// ──────────────────────────────────────────────
// Task  (включая подзадачи через self-relation)
// ──────────────────────────────────────────────

model Task {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  startTime       DateTime?
  durationMinutes Int?
  color           String    @default("#6B5BFC")
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // iCal RRULE, напр. "FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR"
  parentTaskId    String?
  parentTask      Task?     @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks        Task[]    @relation("SubTasks")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([userId, startTime])
  @@map("tasks")
}

// ──────────────────────────────────────────────
// Routine  (шаблон повторяющихся задач)
// ──────────────────────────────────────────────

model Routine {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  daysOfWeek Int[]    // 0=Вс, 1=Пн, ..., 6=Сб
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("routines")
}

// ──────────────────────────────────────────────
// FocusSession  (body doubling)
// ──────────────────────────────────────────────

model FocusSession {
  id              String    @id @default(uuid())
  hostUserId      String
  host            User      @relation("HostedSessions", fields: [hostUserId], references: [id])
  dailyRoomUrl    String?   // URL из Daily.co REST API
  isPublic        Boolean   @default(true)
  maxParticipants Int       @default(10)
  timerMinutes    Int       @default(25)  // Pomodoro = 25 мин по умолчанию
  createdAt       DateTime  @default(now())
  endedAt         DateTime?

  participants FocusSessionParticipant[]

  @@map("focus_sessions")
}

model FocusSessionParticipant {
  id        String       @id @default(uuid())
  sessionId String
  session   FocusSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?

  @@unique([sessionId, userId])
  @@map("focus_session_participants")
}

// ──────────────────────────────────────────────
// DeviceToken  (per-device push token registry, ADR-009)
// Replaces single expoPushToken on User.
// Multiple authenticated devices can register independently.
// ──────────────────────────────────────────────

model DeviceToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String    @unique
  platform    String    @default("expo") // "expo" | "apns" | "fcm"
  label       String?   // optional device label (e.g. "iPhone 14")
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? // null = active; non-null = revoked (DeviceNotRegistered or explicit removal)

  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([userId, revokedAt]) // fast "active tokens for user" query
  @@map("device_tokens")
}

// ──────────────────────────────────────────────
// NotificationLog  (для отладки надёжности доставки)
// ──────────────────────────────────────────────

model NotificationLog {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  deviceTokenId String?      // null for legacy or no-tokens paths
  deviceToken   DeviceToken? @relation(fields: [deviceTokenId], references: [id])
  sentAt        DateTime     @default(now())
  delivered     Boolean      @default(false)

  @@index([userId])
  @@index([taskId, deviceTokenId]) // per-device dedup query
  @@map("notification_logs")
}
