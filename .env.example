# Database
DATABASE_URL="postgresql://focus_user:focus_pass@localhost:5432/focus_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="замените-на-длинную-случайную-строку-минимум-64-символа"
JWT_REFRESH_SECRET="другая-длинная-случайная-строка-для-refresh-токенов"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App
# Optional; defaults to 3000 when omitted.
PORT=3000
NODE_ENV="development"
# Development-only plan mutation endpoints. Exact lowercase "true" enables them
# outside production; omit or leave false for normal use.
ENABLE_DEV_PLAN_MUTATIONS="false"

# Contact verification foundation (disabled by default; Task 0035 will enforce it)
CONTACT_VERIFICATION_ENABLED="false"
CONTACT_VERIFICATION_SECRET=""
SMSAERO_EMAIL=""
SMSAERO_API_KEY=""
SMSAERO_SIGN=""
TIMEWEB_SMTP_USER=""
TIMEWEB_SMTP_PASSWORD=""
TIMEWEB_SMTP_FROM_EMAIL=""
TIMEWEB_SMTP_FROM_NAME="Focus"

# AI (опционально, для будущих фич)
YANDEXGPT_API_KEY=""
GIGACHAT_API_KEY=""

# WebRTC — Daily.co
# Зарегистрироваться на https://dashboard.daily.co/signup
DAILY_API_KEY=""
DAILY_DOMAIN=""

# Push-уведомления (Expo)
# Получить на https://expo.dev в настройках проекта
EXPO_ACCESS_TOKEN=""
